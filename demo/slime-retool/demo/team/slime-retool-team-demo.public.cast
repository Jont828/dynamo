[0.609, "o", "  \u001b[38;2;57;135;229m██\u001b[0m KV-aware   \u001b[38;2;217;89;38m██\u001b[0m Round-robin\r\n\r\n  \u001b[1mWhere each step's slowest trajectory, the one its rollout waits for, spent its time (sum of 10 steps)\u001b[0m\r\n  generating tokens         KV-aware     \u001b[38;2;57;135;229m▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄\u001b[0m 938 s\r\n                            Round-robin  \u001b[38;2;217;89;38m▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄\u001b[0m 873 s\r\n\r\n  between turns (sandbox)   KV-aware     \u001b[38;2;57;135;229m▄▖\u001b[0m 24 s\r\n                            Round-robin  \u001b[38;2;217;89;38m▄▄▄▄▄▄▄▄▄▖\u001b[0m 148 s\r\n\r\n  waiting for first tokens  KV-aware     \u001b[38;2;57;135;229m▄\u001b[0m 13 s\r\n                            Round-robin  \u001b[38;2;217;89;38m▄\u001b[0m 18 s\r\n\r\n  be"]
[0.0, "o", "fore its first turn     KV-aware     \u001b[38;2;57;135;229m▖\u001b[0m 7 s\r\n                            Round-robin  \u001b[38;2;217;89;38m▖\u001b[0m 5 s\r\n"]
