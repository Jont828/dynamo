[0.0, "o", "  \u001b[0;90m403 \u001b[0m\u001b[0;35masync\u001b[0m \u001b[0;35mdef\u001b[0m \u001b[0;34mgenerate\u001b[0;96m(\u001b[0;93margs\u001b[0;96m,\u001b[0m \u001b[0;93msample\u001b[0;96m:\u001b[0m \u001b[0;93mSample\u001b[0;96m,\u001b[0m \u001b[0;93msampling_params\u001b[0;96m)\u001b[0m \u001b[0;96m-\u001b[0;96m>\u001b[0m \u001b[0mSample\u001b[0;96m:\u001b[0m"]
[0.0, "o", "\u001b[2;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m404 \u001b[0m\u001b[0m    \u001b[0;95m\"\"\"\u001b[0;32mCustom generation function supporting tool calls\u001b[0;95m\"\"\"\u001b[0m"]
[0.0, "o", "\u001b[3;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m405 \u001b[0m\u001b[0;36;40m+-- 13 lines: assert not args.partial_rollout, \"Partial rollout is not supported for \" \"this function at the momen\u001b[0m"]
[0.0, "o", "\u001b[4;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m418 \u001b[0m\u001b[0m    \u001b[0mstate\u001b[0m \u001b[0;36m=\u001b[0m \u001b[0;34mGenerateState\u001b[0;96m(\u001b[0;94margs\u001b[0;96m)\u001b[0m"]
[0.0, "o", "\u001b[5;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m419 \u001b[0m\u001b[0m    \u001b[0;37m# PATCH(stream): send every turn to the Dynamo frontend, not to Slime's own router.\u001b[0m"]
[0.0, "o", "\u001b[6;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m420 \u001b[0m\u001b[0m    \u001b[0mbase_url\u001b[0m \u001b[0;36m=\u001b[0m \u001b[0mos\u001b[0;96m.\u001b[0;31menviron\u001b[0;96m.\u001b[0;34mget\u001b[0;96m(\u001b[0;95m\"\u001b[0;32mDYNAMO_ROLLOUT_URL\u001b[0;95m\"\u001b[0;96m)\u001b[0m \u001b[0;36mor\u001b[0m \u001b[0;35mf\u001b[0;95m\"\u001b[0;32mhttp://{args.sglang_router_ip}:{args.sglang_router_port}\u001b[0;95m\"\u001b[0m"]
[0.0, "o", "\u001b[7;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m421 \u001b[0m\u001b[0m    \u001b[0murl\u001b[0m \u001b[0;36m=\u001b[0m \u001b[0;35mf\u001b[0;95m\"\u001b[0;32m{base_url.rstrip('/')}/generate\u001b[0;95m\"\u001b[0m"]
[0.0, "o", "\u001b[8;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m422 \u001b[0m\u001b[0m"]
[0.0, "o", "\u001b[9;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m423 \u001b[0m\u001b[0m    \u001b[0;37m# Set up the initial prompt with system prompt and tools (outside the loop)\u001b[0m"]
[0.0, "o", "\u001b[10;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m424 \u001b[0m\u001b[0m    \u001b[0mtool_specs\u001b[0m \u001b[0;36m=\u001b[0m \u001b[0mtool_registry\u001b[0;96m.\u001b[0;34mget_tool_specs\u001b[0;96m(\u001b[0;96m)\u001b[0m"]
[0.0, "o", "\u001b[11;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m425 \u001b[0m\u001b[0m    \u001b[0mquestion\u001b[0m \u001b[0;36m=\u001b[0m \u001b[0;34m_question_text\u001b[0;96m(\u001b[0;94msample\u001b[0;96m.\u001b[0;31mprompt\u001b[0;96m)\u001b[0m  \u001b[0;37m# PATCH(prompt)\u001b[0m"]
[0.0, "o", "\u001b[12;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m426 \u001b[0m\u001b[0m    \u001b[0mprompt\u001b[0m \u001b[0;36m=\u001b[0m \u001b[0;34mformat_conversation_with_tools\u001b[0;96m(\u001b[0;94mprompt\u001b[0;36m=\u001b[0;94mquestion\u001b[0;96m,\u001b[0m \u001b[0;94mtools\u001b[0;36m=\u001b[0;94mtool_specs\u001b[0;96m)\u001b[0m"]
[0.0, "o", "\u001b[13;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m427 \u001b[0m\u001b[0m"]
[0.0, "o", "\u001b[14;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m428 \u001b[0m\u001b[0m    \u001b[0mprompt_tokens_ids\u001b[0m \u001b[0;36m=\u001b[0m \u001b[0mstate\u001b[0;96m.\u001b[0;34mtokenizer\u001b[0;96m(\u001b[0;94mprompt\u001b[0;96m,\u001b[0m \u001b[0;94madd_special_tokens\u001b[0;36m=\u001b[0;91mFalse\u001b[0;96m)\u001b[0;96m[\u001b[0;95m\"\u001b[0;32minput_ids\u001b[0;95m\"\u001b[0;96m]\u001b[0m"]
[0.0, "o", "\u001b[15;1H\u001b[K"]
[0.001, "o", "  \u001b[0;90m429 \u001b[0m\u001b[0;36;40m+-- 12 lines: sample.tokens = list(prompt_tokens_ids) ------------------------------------------------------------\u001b[0m"]
[0.0, "o", "\u001b[16;1H\u001b[K"]
[0.0, "o", "  \u001b[0;90m441 \u001b[0m\u001b[0m    \u001b[0;36mfor\u001b[0m \u001b[0mturn\u001b[0m \u001b[0;36min\u001b[0m \u001b[0;34mrange\u001b[0;96m(\u001b[0;94mTOOL_CONFIGS\u001b[0;96m[\u001b[0;95m\"\u001b[0;32mmax_turns\u001b[0;95m\"\u001b[0;96m]\u001b[0;96m)\u001b[0;96m:\u001b[0m"]
[0.0, "o", "\u001b[17;1H\u001b[K"]
