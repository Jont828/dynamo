[0.0, "o", "     \u001b[0;37mWhat KV-aware routing saved, and whether that made the run faster than a round-robin baseline.\u001b[0m\r\n\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
