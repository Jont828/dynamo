[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.0, "o", "  \u001b[1m🎉 Done: Slime Trained Qwen3-4B for 10 Steps, and Dynamo Served Every Turn\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.001, "o", "\u001b[?25l"]
[0.81, "o", "   \u001b[1mHardware     \u001b[0mOne ND96isr H100 v5 node on AKS: 4 GPUs for Dynamo's SGLang engines, 4 for Slime's trainer\r\n"]
[0.0, "o", "   \u001b[1mStorage      \u001b[0mAzure Managed Lustre: the model, the dataset, and 11 weight syncs\r\n"]
[0.0, "o", "   \u001b[1mWork         \u001b[0m2,560 trajectories, 12,402 requests (4.8 per trajectory), 6.56M tokens generated\r\n"]
[0.0, "o", "   \u001b[1mTime         \u001b[0mRayJob 29 min 14 s: rollouts 985 s, training 383 s, weight syncs 229 s (write 108 s + load 121 s)\r\n"]
[0.0, "o", "   \u001b[1mAnswers      \u001b[0m1,286 of 2,560 correct (50%). Ten steps are too few to show learning.\r\n"]
[0.0, "o", "   \u001b[1mKV routing   \u001b[0mPrefill work nearly halved (5.66M vs 10.45M tokens), with no measurable speedup here.\r\n\r\n"]
[0.0, "o", "   \u001b[0;97m\u001b[1mSlime trains. Dynamo serves every turn. New weights every step. 🔁\u001b[0m\r\n\r\n"]
