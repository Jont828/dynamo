[0.0, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[1m📦 Step 2: Stage the Model and Data on Azure Managed Lustre\u001b[0m\r\n"]
[0.0, "o", "     \u001b[0;37mEvery Pod in the run shares one folder, /data: the setup Job, the 4 engines, and the trainer.\u001b[0m\r\n     \u001b[0;37mIt holds the checkpoint, a copy in the trainer's format, the 17,398 problems, and each step's new weights.\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
