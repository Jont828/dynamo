[0.259, "m", "Step 4: Set Up the Training Side with Slime"]
[0.0, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.0, "o", "  \u001b[1m🧩 Step 4: Set Up the Training Side with Slime\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "\u001b[?25l"]
[0.814, "o", "\u001b[?25l"]
[0.31, "o", "\u001b[0;37m# Slime, THUDM's RL training framework, runs the training side. Setting it up takes two pieces:\u001b[0m\r\n"]
[0.0, "o", "\u001b[?25l"]
[1.011, "o", "\u001b[?25l"]
[1.013, "o", "\u001b[?25l"]
[1.013, "o", "\u001b[?25l"]
[0.758, "o", "\u001b[?25l"]
[0.31, "o", "\u001b[0;37m# the task code (this step), which makes and scores trajectories, and a RayJob (Step 5) whose entrypoint is\u001b[0m\r\n"]
[0.001, "o", "\u001b[?25l"]
[1.012, "o", "\u001b[?25l"]
[1.009, "o", "\u001b[?25l"]
[1.01, "o", "\u001b[?25l"]
[1.011, "o", "\u001b[?25l"]
[0.785, "o", "\u001b[0;37m# python3 train.py <args>: a declarative ray job submit, as the DGD's engines run python3 -m sglang.launch_server.\u001b[0m\r\n"]
[0.001, "o", "\u001b[?25l"]
[1.012, "o", "\u001b[?25l"]
[1.013, "o", "\u001b[?25l"]
[1.012, "o", "\u001b[?25l"]
[1.011, "o", "\u001b[?25l"]
[0.415, "o", "  \u001b[0;90m╭─ \u001b[0m\u001b[1mWho writes generate?\u001b[0;90m ─────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n"]
[0.002, "o", "  \u001b[0;90m│\u001b[0m Built into Slime: a \u001b[0;34mgenerate\u001b[0m that sends one request per trajectory, enough for single-turn tasks.\u001b[0m              \u001b[0;90m│\u001b[0m\r\n"]
[0.0, "o", "\u001b[?25l"]
[1.007, "o", "\u001b[?25l"]
[1.013, "o", "\u001b[?25l"]
[1.011, "o", "\u001b[?25l"]
[0.43, "o", "  \u001b[0;90m│\u001b[0m Multi-turn tool use needs its own. Slime's ReTool example ships one: examples/retool/generate_with_retool.py.\u001b[0m  \u001b[0;90m│\u001b[0m\r\n"]
[0.001, "o", "\u001b[?25l"]
[1.011, "o", "\u001b[?25l"]
[1.007, "o", "\u001b[?25l"]
[1.009, "o", "  \u001b[0;90m│\u001b[0m Your own multi-turn task or tool: write or adapt one. This kit runs a patched copy (PATCH comments): every\u001b[0m     \u001b[0;90m│\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;90m│\u001b[0m turn streams through Dynamo, plus bug fixes.\u001b[0m                                                                   \u001b[0;90m│\u001b[0m\r\n"]
