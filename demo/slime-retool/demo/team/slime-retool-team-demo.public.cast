[0.0, "o", "\u001b[31;1H\u001b[0;1;7mmanifests/dgd.yaml [+]                                                                                25,23          Bot\u001b[0m"]
[0.001, "o", "\u001b[25;1H\u001b[0;37;40m╭─ \u001b[0;1;33;40m▶ lines 20–25\u001b[0;37;40m ──────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m"]
[0.0, "o", "\u001b[26;1H\u001b[0;37;40m│\u001b[0;40m The \u001b[1mfrontend\u001b[0;40m, Dynamo's HTTP entry point and router:                                                                  \u001b[0;37;40m│\u001b[0m"]
[0.0, "o", "\u001b[27;1H\u001b[0;37;40m│\u001b[0;40m DYN_SGLANG_ENABLE_GENERATE=1: serve SGLang's /generate (token IDs in and out), which Slime calls.                    \u001b[0;37;40m│\u001b[0m"]
[0.0, "o", "\u001b[28;1H\u001b[0;37;40m│\u001b[0;40m DYN_ROUTER_MODE=kv: \u001b[1mKV-aware routing\u001b[0;40m, to the engine that already processed most of the prompt, unless it's busier.   \u001b[0;37;40m│\u001b[0m"]
[0.001, "o", "\u001b[29;1H\u001b[0;37;40m│\u001b[0;40m DYN_ROUTER_PREDICTED_TTL_SECS=5: for 5 s after routing, assume that engine has the prompt.                           \u001b[0;37;40m│\u001b[0m"]
[0.0, "o", "\u001b[30;1H\u001b[0;37;40m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
