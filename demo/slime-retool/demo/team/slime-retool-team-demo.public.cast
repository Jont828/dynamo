[0.31, "o", "\u001b[0;37m# Verdict: KV-aware routing nearly halved the prefill, not the run time. The run is decode-bound:\u001b[0m\r\n"]
[0.0, "o", "\u001b[?25l"]
[1.008, "o", "\u001b[?25l"]
[1.012, "o", "\u001b[?25l"]
[1.011, "o", "\u001b[?25l"]
[0.757, "o", "\u001b[?25l"]
[0.31, "o", "\u001b[0;37m# its slowest trajectories mostly generate tokens, and a cache hit only saves prefill.\u001b[0m\r\n"]
[0.001, "o", "\u001b[?25l"]
[1.011, "o", "\u001b[?25l"]
[1.007, "o", "\u001b[?25l"]
[1.006, "o", "\u001b[?25l"]
[0.452, "o", "\u001b[0;37m# Step-to-step swings came from long replies and 20 s sandbox timeouts (7 in round-robin's, 1 in KV-aware's).\u001b[0m\r\n"]
