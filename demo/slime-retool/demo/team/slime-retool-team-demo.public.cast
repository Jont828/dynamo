[1.013, "o", "\r\n  \u001b[1mThe RL loop, repeated (10 times in this run):\u001b[0m\r\n"]
[0.0, "o", "   \u001b[0;91m①\u001b[0m rollout      Dynamo serves every turn while \u001b[0;34mgenerate()\u001b[0m makes trajectories and \u001b[0;34mreward_func()\u001b[0m scores them\r\n   \u001b[0;91m②\u001b[0m train        the trainer updates the weights toward the trajectories that scored higher\r\n"]
[0.0, "o", "   \u001b[0;91m③\u001b[0m weight sync  the trainer writes the new weights to Lustre; each engine loads them for the next rollout\r\n"]
[0.0, "o", "\u001b[?25h"]
[1.011, "o", "\u001b[?25h"]
[1.014, "o", "\u001b[?25h"]
[1.013, "o", "\u001b[?25h"]
[1.007, "o", "\u001b[?25h"]
[1.009, "o", "\u001b[?25h"]
[1.007, "o", "\u001b[?25h"]
[1.006, "o", "\r\n  \u001b[1mOne AKS node · Standard_ND96isr_H100_v5 · 8 × H100 80 GB\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;90m┌─ \u001b[0m\u001b[1mDynamo serves the model\u001b[0m\u001b[0;90m ──────────────────┐\u001b[0m   \u001b[0;91m①\u001b[0m rollout    \u001b[0;90m┌─ \u001b[0m\u001b[1mSlime trains it, on KubeRay\u001b[0m\u001b[0;90m ──────────────┐\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;90m│\u001b[0m frontend + router                         \u001b[0m \u001b[0;90m│\u001b[0m ◀─── turns ─── \u001b[0;90m│\u001b[0m generate(), reward_func(), sandbox (CPU)  \u001b[0m \u001b[0;90m│\u001b[0m\r\n"]
[0.001, "o", "  \u001b[0;90m│\u001b[0m ▣ ▣ ▣ ▣  4 SGLang engines, 1 GPU each     \u001b[0m \u001b[0;90m│\u001b[0m ── replies ──▶ \u001b[0;90m│\u001b[0m ▣ ▣ ▣ ▣  Megatron-LM trainer, 4 GPUs      \u001b[0m \u001b[0;90m│\u001b[0m\r\n"]
[0.0, "o", "  \u001b[0;90m└────────────────────────────────────────────┘\u001b[0m                \u001b[0;90m└────────────────────────────────────────────┘\u001b[0m\r\n"]
[0.0, "o", "        ▲ \u001b[0;91m③\u001b[0m each engine loads the new weights                         │ \u001b[0;91m③\u001b[0m the trainer writes them\r\n"]
[0.0, "o", "        │                                                             ▼\r\n"]
