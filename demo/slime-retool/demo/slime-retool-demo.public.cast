[0.707, "o", "\r\n"]
[0.855, "o", "\u001b[0;37m# Every request resends the whole transcript as token IDs. The engine that served the last turn\u001b[0m\r\n"]
[0.859, "o", "\u001b[0;37m# already holds all of it except the sandbox output, so routing there skips the re-prefill.\u001b[0m\r\n"]
[0.859, "o", "\u001b[0;37m# This kit's copy streams each turn (Dynamo 1.6 serves /generate as a stream), stops at\u001b[0m\r\n"]
[0.858, "o", "\u001b[0;37m# </tool_call>, fixes the sandbox, and logs every turn. The README lists each change.\u001b[0m\r\n\r\n"]
