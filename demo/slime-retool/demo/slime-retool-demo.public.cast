[0.858, "o", "\u001b[0;37m# hit: the share of prompt tokens the engines served from their prefix cache.\u001b[0m\r\n"]
[0.862, "o", "\u001b[0;37m# stayed: follow-up turns routed to the engine that served the trajectory's previous turn.\u001b[0m\r\n"]
[0.859, "o", "\u001b[0;37m# The router weighs each turn's cached history against engine load: the other follow-ups\u001b[0m\r\n"]
[0.857, "o", "\u001b[0;37m# went to a less loaded engine and recomputed their history there.\u001b[0m\r\n"]
