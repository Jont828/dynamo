[0.854, "o", "\u001b[0;37m# SGLang serves the Hugging Face checkpoint. Megatron-LM starts from the torch_dist copy.\u001b[0m\r\n"]
[1.208, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[1m🚀 Step 2: Serve Rollouts with KV-Aware Routing\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.0, "o", "\r\n"]
[0.859, "o", "\u001b[0;37m# A DynamoGraphDeployment (DGD) runs a Dynamo frontend and four SGLang engines, one GPU each.\u001b[0m\r\n"]
