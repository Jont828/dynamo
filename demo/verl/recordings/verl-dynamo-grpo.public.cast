[5.0, "o", "\u001b[1m\u001b[36m── One test question, before and after (198 fixed, 18 newly wrong)\u001b[0m\r\n"]
[0.03, "o", "  \u001b[1mQ:\u001b[0m Ali had $21. Leila gave him half of her $100. How much does Ali have now?\r\n"]
[0.03, "o", "  \u001b[1mexpected:\u001b[0m 71\r\n"]
[0.03, "o", "  \u001b[31mbefore (score 0)\u001b[0m, last lines of the answer:\r\n"]
[0.03, "o", "    \u001b[2m│\u001b[0m Now, we add the $50 that Leila gave Ali to Ali's initial amount:\r\n"]
[0.03, "o", "    \u001b[2m│\u001b[0m 4. Ali's new total is $21 (initial amount) + $50 (amount given by Leila) = $71.\r\n"]
[0.03, "o", "    \u001b[2m│\u001b[0m #### $71\r\n"]
[0.03, "o", "  \u001b[32mafter step 15 (score 1)\u001b[0m, last lines of the answer:\r\n"]
[0.03, "o", "    \u001b[2m│\u001b[0m 21 + 50 = 71\r\n"]
[0.03, "o", "    \u001b[2m│\u001b[0m \\]\r\n"]
[0.03, "o", "    \u001b[2m│\u001b[0m #### 71\r\n"]
[0.03, "o", "\r\n"]
