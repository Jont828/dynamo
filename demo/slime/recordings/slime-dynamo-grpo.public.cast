[0.004, "o", "\r\n\u001b[1;36m# The guide's readiness checks, from inside the namespace: both native SGLang engines, then the Dynamo frontend.\u001b[0m\r\n"]
[4.662, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime exec pod/slime-sglang-0-worker-0-gsmhv -- sh -c 'for u in slime-sglang-engine-0:30000/health_generate slime-sglang-engine-1:30000/health_generate slime-sglang-rollout:8000/health; do echo \"$u -> $(curl -s -o /dev/null -w %{http_code} http://$u)\"; done'\u001b[0m\r\n"]
[3.623, "o", "slime-sglang-engine-0:30000/health_generate -> 200\r\n"]
[1.049, "o", "slime-sglang-engine-1:30000/health_generate -> 200\r\nslime-sglang-rollout:8000/health -> 200\r\n"]
[0.005, "o", "\r\n"]
[0.0, "o", "\u001b[1;36m# 4) The training side: a KubeRay RayJob. Its entrypoint (train.sh) adds slime's model/GRPO args and execs\u001b[0m\r\n\u001b[1;36m# Dynamo's launch-slime.sh unchanged. launch-slime.sh passes the engine list and the Dynamo streaming generator.\u001b[0m\r\n"]
[3.01, "o", "\u001b[1;32m$\u001b[0m \u001b[1mgrep -n -E 'entrypoint|PYTHONPATH|DYNAMO_ROLLOUT_URL|num-gpus' rayjob/rayjob.yaml\u001b[0m\r\n"]
[0.009, "o", "18:  entrypoint: bash /opt/slime-dynamo/train.sh\r\n23:      PYTHONPATH: \"/opt/dynamo-example:/opt/slime-dynamo:/root/slime:/root/Megatron-LM\"\r\n24:      DYNAMO_ROLLOUT_URL: \"http://slime-sglang-rollout:8000\"\r\n"]
[0.0, "o", "51:        num-gpus: \"1\"\r\n"]
[0.0, "o", "\u001b[1;32m$\u001b[0m \u001b[1mgrep -n -E 'update-weight|post-write|launch-slime' rayjob/train.sh\u001b[0m\r\n"]
[0.006, "o", "4:# Dynamo's examples/rl/slime/launch-slime.sh supplies only the Dynamo wiring (external engine list,\r\n6:# leaves to the user, then execs launch-slime.sh unchanged from the Dynamo ConfigMap.\r\n"]
[0.0, "o", "72:  --update-weight-mode full\r\n73:  --update-weight-transport disk\r\n74:  --update-weight-disk-dir /data/weight-updates\r\n76:  --custom-update-weight-post-write-path slime_dynamo_hooks.make_weights_readable\r\n79:exec bash /opt/dynamo-example/launch-slime.sh \"${ARGS[@]}\" \"$@\"\r\n"]
[0.0, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime get configmap dynamo-slime-example -o jsonpath='{.data.launch-slime\\.sh}' | tail -8\u001b[0m\r\n"]
[1.437, "o", "\r\nexec python3 \"${SLIME_HOME}/train.py\" \\\r\n    --rollout-external-engine-addrs \"${ENGINE_ADDRS[@]}\" \\\r\n    --rollout-function-path slime.rollout.sglang_rollout.generate_rollout \\\r\n    --custom-generate-function-path \\\r\n    dynamo_generate.generate_streaming \\\r\n    --sglang-incremental-streaming-output \\\r\n    \"$@\"\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl apply -k rayjob\u001b[0m\r\n"]
[1.932, "o", "configmap/slime-dynamo-scripts unchanged\r\n"]
[0.791, "o", "rayjob.ray.io/slime-dynamo created\r\n"]
[0.004, "o", "\r\n"]
[0.0, "o", "\u001b[1;36m# KubeRay starts a Ray head pod (1 GPU for the Megatron trainer) and a submitter pod that runs 'ray job submit'.\u001b[0m\r\n"]
[15.959, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime get rayjob slime-dynamo && kubectl -n slime get pods -o wide | grep -E '^NAME|^slime-dynamo-[a-z0-9]{5}(-head-[a-z0-9]{5})? '\u001b[0m\r\n"]
