{"version":3,"term":{"cols":160,"rows":45},"timestamp":1793840158,"idle_time_limit":3.0,"command":"bash ./demo.sh","title":"slime + NVIDIA Dynamo on AKS: RL rollouts served by Dynamo (KubeRay RayJob + DGD)","env":{"SHELL":"/bin/zsh"}}
[0.02, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.0, "o", "\r\n"]
[0.0, "o", "\u001b[1;36m# slime + NVIDIA Dynamo on AKS: RL training where Dynamo serves the rollouts.\u001b[0m\r\n\u001b[1;36m# Trainer: slime (Megatron) in a KubeRay RayJob. Inference: 2 SGLang engines in a Dynamo DynamoGraphDeployment (DGD).\u001b[0m\r\n"]
[0.0, "o", "\u001b[1;36m# Model: Qwen3-0.6B, GRPO on GSM8K, 10 rollout -> train -> weight-sync loops.\u001b[0m\r\n"]
[3.006, "o", "\r\n\u001b[1;36m# 1) Cluster prerequisites: H100 node pool, Dynamo platform 1.6.1 and the KubeRay operator (both Helm installs).\u001b[0m\r\n"]
[3.007, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl get nodes -l agentpool=ndh100pool -L node.kubernetes.io/instance-type,nvidia.com/gpu.count\u001b[0m\r\n"]
[2.033, "o", "NAME                                 STATUS   ROLES    AGE    VERSION   INSTANCE-TYPE              GPU.COUNT\r\naks-ndh100pool-XXXXXXXX-vmss000000"]
[0.0, "o", "   Ready    <none>   126d   v1.34.8   Standard_ND96isr_H100_v5   8\r\naks-ndh100pool-XXXXXXXX-vmss000001   "]
[0.0, "o", "Ready    "]
[0.0, "o", "<none>"]
[0.0, "o", "   "]
[0.0, "o", "126d"]
[0.0, "o", "   "]
[0.0, "o", "v1.34.8"]
[0.0, "o", "   "]
[0.0, "o", "Standard_ND96isr_H100_v5"]
[0.0, "o", "   8\r\naks-ndh100pool-XXXXXXXX-vmss000002   Ready    <none>   126d   v1.34.8   Standard_ND96isr_H100_v5   8\r\naks-ndh100pool-XXXXXXXX-vmss000003   Ready    <none>   126d   v1.34.8   Standard_ND96isr_H100_v5   "]
[0.0, "o", "8\r\n"]
[0.003, "o", "\u001b[1;32m$\u001b[0m \u001b[1mhelm list -A | grep -E '^NAME|dynamo-platform|kuberay'\u001b[0m\r\n"]
[3.445, "o", "NAME                            \tNAMESPACE              \tREVISION\tUPDATED                                \tSTATUS  \tCHART                                                    \tAPP VERSION    \r\n"]
[0.0, "o", "dynamo-platform                 \tdynamo-system          \t5       \t2026-11-04 17:24:01.154491 -0500 EST   \tdeployed\tdynamo-platform-1.6.1                                    \t1.6.1          \r\n"]
[0.0, "o", "kuberay-operator                \tkuberay                \t2       \t2026-11-04 18:37:59.551626 -0500 EST   \tdeployed\tkuberay-operator-1.7.1                                   \t               \r\n"]
[0.003, "o", "\r\n"]
[0.0, "o", "\u001b[1;36m# 2) Shared storage: one Azure Managed Lustre sub-directory mounted at /data by the trainer AND the engines.\u001b[0m\r\n"]
[0.0, "o", "\u001b[1;36m# prepare-job.yaml filled it once (download, HF -> Megatron conversion); weight syncs will land in /data/weight-updates.\u001b[0m\r\n"]
[3.009, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime get pvc slime-dynamo-data\u001b[0m\r\n"]
[1.298, "o", "NAME                STATUS   VOLUME                   CAPACITY   ACCESS MODES   STORAGECLASS         VOLUMEATTRIBUTESCLASS"]
[0.0, "o", "   AGE\r\nslime-dynamo-data   Bound    pv-lustre-slime-dynamo   1Ti        RWX        "]
[0.0, "o", "    "]
[0.0, "o", "azurelustre-static   <unset>        "]
[0.0, "o", "         "]
[0.0, "o", "47m"]
[0.0, "o", "\r\n"]
[0.004, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime logs job/slime-dynamo-prepare | tail -6\u001b[0m\r\n"]
[1.88, "o", "drwxrwsr-x 6 root ubuntu 4096 Nov  5 00:44 .\r\ndrwxr-xr-x 1 root root   4096 Nov  5 00:44 ..\r\ndrwxrwsr-x 3 root ubuntu 4096 Nov  5 00:25 gsm8k\r\ndrwxrwsr-x 3 root ubuntu 4096 Nov  5 00:10 Qwen3-0.6B\r\ndrwxrwsr-x 3 root ubuntu 4096 Nov  5 00:10 Qwen3-0.6B_torch_dist\r\ndrwxrwsr-x 2 root ubuntu 4096 Nov  5 00:42 weight-updates\r\n"]
[0.001, "o", "\r\n"]
[0.0, "o", "\u001b[1;36m# 3) The inference side: Dynamo's examples/rl/slime/dynamo.yaml, rendered with 1.6.1 images.\u001b[0m\r\n\u001b[1;36m# Our only changes mount /data into the SGLang workers and load the model from it:\u001b[0m\r\n"]
[3.01, "o", "\u001b[1;32m$\u001b[0m \u001b[1mgrep -n 'slime-dynamo-aks' dynamo-dgd.yaml\u001b[0m\r\n"]
[0.01, "o", "18:# Lines marked \"slime-dynamo-aks:\" are the only changes; they let the SGLang engines read the same\r\n"]
[0.0, "o", "97:          volumes: # slime-dynamo-aks: Lustre sub-dir volume shared with the trainer (storage.yaml)\r\n"]
[0.0, "o", "127:              volumeMounts: # slime-dynamo-aks: /data holds the model and /data/weight-updates\r\n136:                - /data/Qwen3-0.6B # slime-dynamo-aks: same HF checkpoint as the trainer's --hf-checkpoint\r\n"]
[0.0, "o", "164:          volumes: # slime-dynamo-aks: Lustre sub-dir volume shared with the trainer (storage.yaml)\r\n"]
[0.0, "o", "194:              volumeMounts: # slime-dynamo-aks: /data holds the model and /data/weight-updates\r\n203:                - /data/Qwen3-0.6B # slime-dynamo-aks: same HF checkpoint as the trainer's --hf-checkpoint\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime apply -f dynamo-dgd.yaml\u001b[0m\r\n"]
[2.442, "o", "service/slime-sglang-rollout created\r\n"]
[0.781, "o", "service/slime-sglang-engine-0 created\r\n"]
[0.855, "o", "service/slime-sglang-engine-1 created\r\n"]
[0.883, "o", "dynamographdeployment.nvidia.com/slime-sglang created\r\n"]
[0.003, "o", "\r\n"]
[0.0, "o", "\u001b[1;36m# The operator creates a frontend plus worker-0/worker-1 (1 GPU each). Each worker runs stock SGLang with the Dynamo sidecar.\u001b[0m\r\n"]
[3.009, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime wait --for=condition=Ready dgd/slime-sglang --timeout=15m\u001b[0m\r\n"]
