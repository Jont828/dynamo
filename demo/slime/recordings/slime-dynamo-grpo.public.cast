[0.002, "o", "\r\n\u001b[1;36m# 5) Evidence from the Dynamo side. The frontend routed all 640 rollout requests (10 x 64) round-robin across both workers:\u001b[0m\r\n"]
[4.345, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime logs pod/slime-sglang-0-frontend-bg7cd | perl -pe 's/\\e\\[[0-9;]*m//g' | grep 'Selected worker' | grep -o -E 'router_mode=\"[a-z-]+\" worker_id=[0-9]+' | sort | uniq -c\u001b[0m\r\n"]
[2.93, "o", " 320 router_mode=\"round-robin\" worker_id=6644286532210461\r\n"]
[0.001, "o", " 320 router_mode=\"round-robin\" worker_id=8388052278640619\r\n"]
[0.0, "o", "\r\n"]
[0.0, "o", "\u001b[1;36m# ...and each SGLang engine served its share and reloaded every policy version from /data (startup sync + 1 per step):\u001b[0m\r\n"]
[4.648, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime logs pod/slime-sglang-0-worker-0-gsmhv | grep -c 'POST /generate HTTP/1.1\" 200'   # worker-0: requests from its Dynamo sidecar\u001b[0m\r\n"]
[2.72, "o", "321\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1mkubectl -n slime logs pod/slime-sglang-0-worker-0-gsmhv | grep -c 'POST /update_weights_from_disk HTTP/1.1\" 200'   # worker-0: policy reloads\u001b[0m\r\n"]
[2.683, "o", "11\r\n"]
