[0.305, "o", "\r\n  \u001b[1mWhat it took\u001b[0m\r\n  \u001b[32m✓\u001b[0m 1 node with 3 free GPUs                                                 \u001b[2mevery time\u001b[0m\r\n  \u001b[32m✓\u001b[0m GPU operator, KubeRay operator, a storage class; no Dynamo operator     \u001b[2mone-time, already in place\u001b[0m\r\n  \u001b[32m✓\u001b[0m An image built from NeMo RL main with BUILD_DYNAMO=1                    \u001b[2mone-time, already pushed\u001b[0m\r\n  \u001b[32m✓\u001b[0m kubectl apply -k .  (namespace, scripts ConfigMap, cache PVC)           \u001b[2mevery time, idempotent\u001b[0m\r\n  \u001b[32m✓\u001b[0m kubectl apply -f k8s/setup-job.yaml  (image pull, models, dataset)      \u001b[2mone-time, ~20 min\u001b[0m\r\n  \u001b[32m✓\u001b[0m kubectl apply -f k8s/rayjob.yaml + kubectl logs -f job/nemo-rl-grpo-demo \u001b[2mevery time, ~17 min\u001b[0m\r\n\r\n"]
