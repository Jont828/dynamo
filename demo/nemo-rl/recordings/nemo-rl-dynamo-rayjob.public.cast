[1.949, "o", "run: grpo-20261113-001238   (94809 lines in run.log)\r\n\r\n\u001b[1;32m$\u001b[0m grep -E '\\[Dynamo\\] (frontend .* routes to|engine publishes)' run.log | sed -E 's/^.*(\\[Dynamo\\])/\\1/'\r\n[Dynamo] engine publishes KV events: True\r\n[Dynamo] engine publishes KV events: True\r\n[Dynamo] frontend http://10.xxx.x.xx:3032/v1 routes to 2 engine(s)\r\n\r\n\u001b[1;32m$\u001b[0m grep -o '\\[Dynamo\\] router applied KV events: .*' run.log | grep -o -E '\"[a-z_]+\": [1-9][0-9.]*'\r\n\"ok\": 270223.0\r\n\r\n\u001b[1;32m$\u001b[0m grep 'Selected worker' run.log | sed -E 's/.*(router_mode=\"[a-z]+\").* (worker_id=[0-9]+).*/\\1 \\2/' | sort | uniq -c\r\n   6549 router_mode=\"kv\" worker_id=7220855501956877835\r\n   6763 router_mode=\"kv\" worker_id=7220855501956877837\r\n\r\n\u001b[1;32m$\u001b[0m grep 'route request completed request.outcome=\"success\"' run.log | grep -o 'overlap_blocks=[0-9]*' | sed -E 's/=[1-9][0-9]*$/>0/' | sort | uniq -c\r\n    246 overlap_blocks=0\r\n  13066 overlap_blocks>0\r\n"]
