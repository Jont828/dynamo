[1.817, "o", "NAME                 CREATED AT\r\nrayjobs.ray.io       2026-07-09T18:47:36Z\r\nrayclusters.ray.io   2026-07-09T18:47:32Z\r\n\r\n  \u001b[33m┌─ On a fresh AKS cluster you would run (not executed here):\u001b[0m\r\n  \u001b[33m│\u001b[0m \u001b[2mhelm install gpu-operator nvidia/gpu-operator -n gpu-operator --create-namespace\u001b[0m\r\n  \u001b[33m│\u001b[0m \u001b[2mhelm install kuberay-operator kuberay/kuberay-operator -n kuberay --create-namespace --version 1.7.1\u001b[0m\r\n  \u001b[33m│\u001b[0m \u001b[2mkubectl -n nemo-rl-demo create secret generic hf-token-secret --from-literal=HF_TOKEN=hf_...   # optional\u001b[0m\r\n  \u001b[33m└─\u001b[0m\r\n"]
