[0.914, "o", "\u001b[0;37m# SGLang serves the Hugging Face checkpoint. The trainer starts from the torch_dist copy.\u001b[0m\r\n"]
[1.009, "o", "\r\n\r\n"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.0, "o", "  \u001b[1m🚀 Step 2: Serve Rollouts with KV-Aware Routing\u001b[0m\r\n"]
[0.0, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.909, "o", "\u001b[0;37m# A DynamoGraphDeployment (DGD) runs a Dynamo frontend and two SGLang engines, one GPU each.\u001b[0m\r\n"]
[0.915, "o", "\u001b[0;37m# The tutorial's DGD plus two frontend settings and two engine flags turn on KV-aware routing:\u001b[0m\r\n\r\n"]
