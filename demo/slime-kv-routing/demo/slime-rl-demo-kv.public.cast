[0.811, "o", "                - name: DYN_ROUTER_MODE\r\n                  value: kv\r\n                - name: DYN_ROUTER_PREDICTED_TTL_SECS\r\n                  value: \"5\"\r\n--\r\n                - --page-size\r\n                - \"16\"\r\n                - --kv-events-config\r\n                - '{\"publisher\":\"zmq\",\"endpoint\":\"tcp://*:5557\",\"topic\":\"\"}'\r\n\r\n"]
